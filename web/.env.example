# Contraseña del panel /admin
ADMIN_PASSWORD=cambia-esto

# Para que el panel guarde en GitHub cuando la web está en Vercel.
# Token "fine-grained" con permiso Contents: Read and write solo sobre este repo.
GITHUB_TOKEN=
GITHUB_REPO=polsanchezfernandez/polsanchezfernandez.github.io
GITHUB_BRANCH=main
# Carpeta del repo donde está la web
GITHUB_DIR=web
